=== 1. band = tier from PRIOR CLOSE, centre = MOVING reference price ===
tier1 prior_close= 50.00 ref= 50.00 closing_window=False -> band +/-5.00% = [47.5000, 52.5000] doubled=False
tier1 prior_close= 50.00 ref= 50.00 closing_window=True  -> band +/-10.00% = [45.0000, 55.0000] doubled=True
tier2 prior_close= 50.00 ref= 50.00 closing_window=False -> band +/-10.00% = [45.0000, 55.0000] doubled=False
tier2 prior_close= 50.00 ref= 50.00 closing_window=True  -> band +/-10.00% = [45.0000, 55.0000] doubled=False
tier2 prior_close=  2.00 ref=  2.00 closing_window=True  -> band +/-40.00% = [1.2000, 2.8000] doubled=True
tier1 prior_close=  0.50 ref=  0.50 closing_window=False -> band +/-30.00% = [0.3500, 0.6500] doubled=False
